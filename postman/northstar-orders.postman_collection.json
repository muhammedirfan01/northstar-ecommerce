            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "{{customerCookie}}"
          }
        ],
        "url": "{{baseUrl}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\"addressId\":\"{{addressId}}\",\"paymentMethod\":\"cod\",\"requestId\":\"{{requestId}}\",\"expectedTotalPaise\":15000}"
        }
