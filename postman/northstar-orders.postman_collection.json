      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Same order\", () => pm.expect(pm.response.json().data.order.id).to.eql(pm.collectionVariables.get(\"orderId\")));"
            ]
          }
        }
      ]
